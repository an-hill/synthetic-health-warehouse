# Python bytecode
__pycache__/
*.pyc

# Packaging artefacts from hatchling
build/
dist/
*.egg-info/

# Environments and secrets
.env
.envrc
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Written by importing airflow, which insists on an AIRFLOW_HOME existing.
.airflow/

# ---------------------------------------------------------------------------
# dbt-airflow
# ---------------------------------------------------------------------------

# Personal notes and Claude artefacts. Never ships in the public repo.
/.private/

# The warehouse itself, rebuilt from the committed CSVs by the loader. Binary,
# rewritten every run, and git history is permanent, so committing it once
# bloats every future clone even after removal.
*.duckdb
*.duckdb.wal

# dbt build output, compiled SQL, and installed packages
target/
dbt_packages/
logs/

# dbt writes an anonymous user id into the project directory on first run.
.user.yml

# Astronomer CLI state, which is local and regenerated. `airflow_settings.yaml`
# is tracked instead, so a clone gets the dbt pool without a walkthrough.
.astro/

# macOS directory metadata
.DS_Store
